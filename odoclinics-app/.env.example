# Base de datos (PostgreSQL — alojada en la UE, sección 7)
DATABASE_URL="postgresql://usuario:password@localhost:5432/odoclinics"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-uno-con: openssl rand -base64 32"

# Seed inicial (cambiar tras el primer login, sección 7)
SEED_PASSWORD_OLIVIA=""
SEED_PASSWORD_JAUME=""

