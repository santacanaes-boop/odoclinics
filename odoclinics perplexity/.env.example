# Base de datos (PostgreSQL — alojada en la UE, sección 7)
DATABASE_URL="postgresql://usuario:password@localhost:5432/odoclinics"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-uno-con: openssl rand -base64 32"

# Seed inicial (cambiar tras el primer login, sección 7)
SEED_PASSWORD_OLIVIA=""
SEED_PASSWORD_JAUME=""

# Cifrado de campo real (sección 7) — dniNie, telefono, email, dirección,
# anamnesis y mfaSecret se cifran en servidor antes de guardarse (ver
# src/lib/cifrado.ts). Clave maestra de 32 bytes en base64:
#   openssl rand -base64 32
# NUNCA la cambies una vez haya datos cifrados en producción sin un plan de
# re-cifrado explícito — perderías el acceso a todo lo cifrado.
CIFRADO_KEY=""

# Carpeta donde se guardan radiografías, firmas y simulaciones (fuera de
# public/; se sirven solo con sesión vía /api/archivos). Opcional: por defecto
# ./almacenamiento. En un hosting, ponla FUERA de la carpeta de la app para
# que no se borre al actualizar (ver DESPLIEGUE_NOMINALIA.md).
UPLOADS_DIR=""

# Nunca poner aquí claves de APIs de terceros que el CLIENTE pueda leer.
# Las integraciones de la sección 4.12 (WhatsApp, IA, banca...) se gestionan
# cifradas en servidor y se añaden en fases posteriores.
